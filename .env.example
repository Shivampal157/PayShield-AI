# ============================================================================
# PayShield AI — Environment Configuration Template
# Copy this file to .env for local development. Never commit real credentials.
# ============================================================================

# Server & Environment
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
APP_COOKIE_SECURE=false

# PostgreSQL 16 Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=payshield
POSTGRES_USER=payshield_user
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DEV_PG_PASS

# Redis 7 Risk & Cache Engine
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Apache Kafka 3.7 (KRaft Mode)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# OpenSearch 2.12 Vector Engine
OPENSEARCH_SCHEME=http
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_ENABLED=true

# JWT & Account Security
# Must be at least 256 bits (32+ ASCII characters) in production
JWT_SECRET=payshield-local-dev-only-hmac-sha256-secret-key-replace-in-prod-99887766
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800

# Optional First-Admin Bootstrap (Leave blank unless bootstrapping initial admin)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Risk Engine Thresholds
RISK_VELOCITY_MAX_ATTEMPTS=5
RISK_VELOCITY_WINDOW_SECONDS=60
RISK_FLAG_THRESHOLD=0.65
RISK_DECLINE_THRESHOLD=0.85

# AI Dispute Copilot (OpenAI-Compatible or Google Gemini Adapter)
# Supported providers: OPENAI_COMPATIBLE, GEMINI, OFFLINE
AI_PROVIDER=OFFLINE
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=10
