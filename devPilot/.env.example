# PostgreSQL (Docker Compose)
POSTGRES_DB=devpilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend Environment
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/devpilot
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
APP_FRONTEND_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_TOKEN_ENCRYPTOR_PASSWORD=devpilot-local-token-secret-2026
APP_TOKEN_ENCRYPTOR_SALT=7f7c15b8d7a340c2

# GitHub OAuth App (Callback: http://localhost:8080/login/oauth2/code/github)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# OpenAI / OpenRouter API
SPRING_AI_OPENAI_BASE_URL=https://api.openai.com
SPRING_AI_OPENAI_API_KEY=your-openai-api-key
SPRING_AI_OPENAI_CHAT_MODEL=gpt-4o-mini
SPRING_AI_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Frontend (.env.local in client/)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
